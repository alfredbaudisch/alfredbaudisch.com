<header class="site-header box-border">
  <div class="container">
    <div class="header-content">
      <a href="/" class="site-logo">
        <span class="site-logo-full">{{ site.title }}</span>
        <span class="site-logo-mobile">{{ site.titleMobile or site.title }}</span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false"></button>
        <ul class="nav-list">
          {% for item in navigation.main %}
          {% if item.hasDropdown %}
          <li class="nav-item-dropdown">
            <a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.title }}</a>
            <ul class="nav-dropdown">
              {% for projectType in collections.projectTypesList %}
              <li><a href="/projects/{{ projectType | slug }}/">{{ projectType }}</a></li>
              {% endfor %}
              <li><a href="/dailies/">Dailies</a></li>
              <li><a href="/experiments/">Experiments</a></li>
            </ul>
          </li>
          {% else %}
          <li><a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.title }}</a></li>
          {% endif %}
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>
</header>


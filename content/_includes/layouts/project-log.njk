---
layout: layouts/base.njk
---
<article class="post project-log">
  <div class="container">
    {% set projectSlug = parentProject %}
    {% set project = collections.projects | findProjectBySlug(projectSlug) %}
    {% set projectType = project.data.projectTypes[0] if project and project.data.projectTypes and project.data.projectTypes.length > 0 else null %}
    {% set projectTypeSlug = projectType | slug if projectType else null %}
    {% if projectType %}
    {% set breadcrumbs = [
      { title: "Projects", url: "/projects/" },
      { title: projectType, url: "/projects/" + projectTypeSlug + "/" },
      { title: project.data.title if project else parentProject, url: project.url if project else "/projects/" + parentProject + "/" },
      { title: "Journal" }
    ] %}
    {% else %}
    {% set breadcrumbs = [
      { title: "Projects", url: "/projects/" },
      { title: project.data.title if project else parentProject, url: project.url if project else "/projects/" + parentProject + "/" },
      { title: "Journal" }
    ] %}
    {% endif %}
    {% include "components/breadcrumbs.njk" %}
    
    <header>
      <h1 class="post-title">{{ title }}</h1>
      <div class="post-meta">
        <time datetime="{{ date | dateISO }}">{{ date | dateDisplay("MMMM d, yyyy") }}</time>
        {% if updated %}
        <span class="updated">Updated: <time datetime="{{ updated | dateISO }}">{{ updated | dateDisplay("MMMM d, yyyy") }}</time></span>
        {% endif %}
      </div>

      {% if featuredImage %}
      <div class="post-featured-image">
        <a href="{{ featuredImage }}" class="featured-image-link" data-lightbox="featured">
          <img src="{{ featuredImage }}" alt="{{ title }}" loading="lazy">
        </a>
      </div>
      {% endif %}
    </header>
    
    <div class="post-content">
      {{ content | safe }}
    </div>
    
    {% if processImage %}
    <section class="process-section">
      <h2>Process</h2>
      <div class="process-image-wrapper">
        <a href="{{ processImage }}" class="process-image-link" data-lightbox="process">
          <img src="{{ processImage }}" alt="Process image for {{ title }}" loading="lazy">
        </a>
      </div>
    </section>
    {% endif %}
    
    {% if links and links.length > 0 and not linksRenderedInline %}
    {% include "components/links-section.njk" %}
    {% endif %}
    
    {% set relatedLogs = collections.projectLogs | getLogsByProject(parentProject) %}
    {% if project %}
    {% set projectName = project.data.title %}
    {% set projectUrl = project.url %}
    {% else %}
    {% set projectName = parentProject %}
    {% set projectUrl = "/projects/" + parentProject + "/" %}
    {% endif %}
    {% include "components/related-logs.njk" %}

    {% if logCategories or tags %}
    <footer class="post-footer">
      {% include "macros/taxonomy.njk" %}
    </footer>
    {% endif %}

    {% include "components/post-navigation.njk" %}
  </div>
</article>


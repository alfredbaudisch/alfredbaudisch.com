---
layout: layouts/base.njk
---
<article class="post">
  <div class="container">
    {% if breadcrumbs %}
    {% include "components/breadcrumbs.njk" %}
    {% endif %}
    
    <header>
      <h1 class="post-title">{{ title }}</h1>
      <div class="post-meta">
        <time datetime="{{ date | dateISO }}">{{ date | dateDisplay("MMMM d, yyyy") }}</time>
        {% if updated %}
        <span class="updated">Updated: <time datetime="{{ updated | dateISO }}">{{ updated | dateDisplay("MMMM d, yyyy") }}</time></span>
        {% endif %}
      </div>
      {% if featuredImage %}
      <div class="post-featured-image">
        <a href="{{ featuredImage }}" class="featured-image-link" data-lightbox="featured">
          <img src="{{ featuredImage }}" alt="{{ title }}" loading="lazy">
        </a>
      </div>
      {% endif %}
    </header>
    
    <div class="post-content">
      {{ content | safe }}
    </div>
    
    {% if processImage %}
    <section class="process-section">
      <h2>Process</h2>
      <div class="process-image-wrapper">
        <a href="{{ processImage }}" class="process-image-link" data-lightbox="process">
          <img src="{{ processImage }}" alt="Process image for {{ title }}" loading="lazy">
        </a>
      </div>
    </section>
    {% endif %}
    
    {% if links and links.length > 0 %}
    <section class="links-section">
      <h2>Links</h2>
      <ul class="links-list">
        {% for link in links %}
        <li><a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.name }}</a></li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    
    {% if tags or projectStyles or projectStatus or projectTypes or tools or experimentTypes or logCategories or categories %}
    <footer class="post-footer">
      {% include "macros/taxonomy.njk" %}
    </footer>
    {% endif %}

    {% include "components/post-navigation.njk" %}
  </div>
</article>